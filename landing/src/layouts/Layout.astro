---
interface Props {
  title: string;
  description: string;
  lang?: string;
}

const { title, description, lang = "zh-CN" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://brainsandbox.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://brainsandbox.com/" />
    <meta property="og:site_name" content="Brain Sandbox" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@JinboWang14" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#2e7d32" />

    <!-- Hreflang for SEO -->
    <link rel="alternate" hreflang="zh-CN" href="https://brainsandbox.com/" />
    <link rel="alternate" hreflang="en" href="https://brainsandbox.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://brainsandbox.com/" />
    <title>{title}</title>

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5959114518130634"
         crossorigin="anonymous"></script>

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KSZZCZGQ4V"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-KSZZCZGQ4V');
    </script>
  </head>
  <body>
    <slot />
    <!-- Language detection handled server-side or by manual switcher -->
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #2e7d32;
    --color-primary-hover: #4caf50;
    --color-primary-dark: #1b5e20;
    --color-bg: #fafafa;
    --color-card: #ffffff;
    --color-text: #212121;
    --color-text-secondary: #616161;
    --color-border: #e0e0e0;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-primary-hover);
  }
</style>
